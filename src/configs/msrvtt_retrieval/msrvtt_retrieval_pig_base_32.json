{
  "train_datasets": {
    "name": "msrvtt-9k",
    "vis_format": "video",
    "txt": "datasets/msrvtt/annotations/train9k.jsonl",
    "vis": "datasets/msrvtt/videos/all"
  },
  "val_datasets": [
    {
      "name": "msrvtt-1ka",
      "vis_format": "video",
      "txt": "datasets/msrvtt/annotations/test1ka.jsonl",
      "vis": "datasets/msrvtt/videos/all"
    }
  ],
  "inference_datasets": [
    {
      "name": "msrvtt-1ka",
      "multi_sentence_per_video": 1,
      "vis_format": "video",
      "txt": "datasets/msrvtt/annotations/test1ka.jsonl",
      "vis": "datasets/msrvtt/videos/all"
    }
  ],
  "do_eval": 0,
  "train_n_clips": 1,
  "train_num_frms": 12,
  "test_n_clips": 1,
  "test_num_frms": 12,
  "sample_rate": 0,
  "sample_jitter": 1,
  "video_res": [
    240,
    320
  ],
  "image_res": [
    224,
    224
  ],
  "input_res": [
    224,
    224
  ],
  "max_txt_len": 50,
  "clip_weights": "openai/clip-vit-base-patch32",
  "clip_config": "openai/clip-vit-base-patch32",
  "freeze_text_model": 0,
  "freeze_text_proj": 0,
  "clip_vision_additional_config": {
    "type": "ViP",
    "temporal_size": 12,
    "if_use_temporal_embed": 1,
    "logit_scale_init_value": 4.60,
    "add_cls_num": 3,
    "keep_frame_cls": 1,
    "use_different_frame_cls": 0
  },
  "generator_config": {
    "fr_model_type": "CLIP-text-encoder",
    "video_mapper_type": "Linear",
    "use_bos_embeds": 1,
    "num_query_token": 1,
    "vision_hidden_dim": 512,
    "model_hidden_dim": 512,
    "Qformer_hidden_dim": 512,
    "overall_text_repr_type": "pick_eot",
    "input_video_tokens_type": "cls+added_cls+frame_cls+cls_attention_scores_no_overlap"
  },
  "fusioner_config": {
    "fusioner_type": "XPoolCrossAttention",
    "text_embeds_type": "eot-level",
    "input_video_tokens_type": "cls+added_cls+frame_cls",
    "select_attention_scores_type": "max",
    "num_selected_tokens": 16,
    "attn_temp": 1,
    "embed_dim": 512,
    "head_dim": 512,
    "transformer_dropout": 0.1,
    "num_mha_heads": 1,
    "num_layers": 1
  },
  "post_training_strategy": "",
  "freeze_clip_encoder_steps": 0,
  "freeze_fusioner_steps": 0,
  "freeze_epochs": 0,
  "train_batch_size": 32,
  "test_batch_size": 32,
  "max_n_example_per_group": 1,
  "gradient_accumulation_steps": 1,
  "n_workers": 8,
  "pin_mem": 1,
  "fp16": 1,
  "amp_level": "O1",
  "seed": 42,
  "optim": "adamw",
  "betas": [
    0.9,
    0.98
  ],
  "learning_rate": 3e-6,
  "weight_decay": 0.2,
  "lr_mul": 1,
  "lr_mul_prefix": [
    ""
  ],
  "loss_config": {
    "loss_name": "NCELearnableTempLoss",
    "if_gather": 1
  },
  "generation_loss_config": {
    "generation_loss_level": "eot",
    "generation_loss_name": "l2",
    "generation_loss_scale": 1.0,
    "norm_before_loss": 1,
    "num_layers": -1
  },
  "warmup_ratio": 0.01,
  "decay": "cosine",
  "grad_norm": 1.0,
  "num_train_epochs": 100,
  "min_valid_steps": 1,
  "num_valid": 1,
  "only_valid_steps": 50,
  "save_steps_ratio": 0.9,
  "output_dir": "outputs/msrvtt/pig_b32",
  "if_tb_log": 0,
  "if_model_saver": 1,
  "if_log2file": 1,
  "dummy_data": 0
}
